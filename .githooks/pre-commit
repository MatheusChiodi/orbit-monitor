#!/bin/sh
# Blocks commits that would publish Orbit configuration, keys or card data.
# Enable once per clone: git config core.hooksPath .githooks
# Regression tests: sh .githooks/pre-commit.test.sh

status=0
files=$(git diff --cached --name-only --diff-filter=ACMR)

# One path per line, so names with spaces stay whole.
IFS='
'
for f in $files; do
  base=$(basename "$f")
  case "$base" in
    *.example.json|*.schema.json|.env.example) ;;
    orbit.*.json|*.json.bak|*.json.tmp|master.key|*.key|*.pem|*.p12|*.pfx|*.jks|*.keystore|id_rsa|id_ed25519|.env|.env.*)
      echo "pre-commit: refusing to commit '$f' (Orbit config, key or env file)."
      status=1
      ;;
  esac
  case "$f" in
    orbit-data/*|*/orbit-data/*|.orbit/*|*/.orbit/*)
      echo "pre-commit: refusing to commit '$f' (local Orbit data)."
      status=1
      ;;
  esac
done
unset IFS

# Content checks on staged additions of every file, tests included.
added=$(git diff --cached -U0 --diff-filter=ACMR --no-color --no-ext-diff | grep '^+' | grep -v '^+++')

if printf '%s\n' "$added" | grep -Eq -- '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----'; then
  echo "pre-commit: a private key is staged."
  status=1
fi

# Card numbers: any span of whole digit groups (joined by single spaces or hyphens) with 13-19 digits
# that passes Luhn and starts like a card (2-6), so "order 12 4111 1111 1111 1111" is caught too.
# The well-known public test numbers are allowed; build any other test number at runtime.
cards=$(printf '%s\n' "$added" | awk '
  BEGIN {
    split("4111111111111111 4242424242424242 4012888888881881 4000056655665556 5555555555554444 " \
          "5105105105105100 5200828282828210 2223003122003222 378282246310005 371449635398431 " \
          "6011111111111117 6011000990139424 3566002020360505 30569309025904 38520000023237 " \
          "6200000000000005 4222222222222", list, " ")
    for (k in list) allowed[list[k]] = 1
  }
  function luhn(d,    i, x, sum, alt) {
    sum = 0; alt = 0
    for (i = length(d); i >= 1; i--) {
      x = substr(d, i, 1) + 0
      if (alt) { x *= 2; if (x > 9) x -= 9 }
      sum += x; alt = !alt
    }
    return sum % 10 == 0
  }
  {
    line = $0
    while (match(line, /[0-9]+([ -][0-9]+)*/)) {
      run = substr(line, RSTART, RLENGTH)
      line = substr(line, RSTART + RLENGTH)
      n = split(run, groups, /[ -]/)
      for (i = 1; i <= n; i++) {
        digits = ""
        for (j = i; j <= n && length(digits) <= 19; j++) {
          digits = digits groups[j]
          if (length(digits) >= 13 && length(digits) <= 19 && digits ~ /^[2-6]/ \
              && !(digits in allowed) && luhn(digits)) {
            print "****" substr(digits, length(digits) - 3)
          }
        }
      }
    }
  }' | sort -u)
if [ -n "$cards" ]; then
  echo "pre-commit: staged content contains values that look like card numbers (Luhn-valid):"
  printf '            %s\n' $cards
  echo "            Use a public test number or build one at runtime; never commit a real card."
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit blocked. See docs/04-data-protection.md and docs/06-configuration-files.md."
fi
exit $status
