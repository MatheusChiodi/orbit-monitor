{
  "version": 1,
  "items": [
    {
      "id": "chn_payments_slack",
      "name": "Payments team (Slack)",
      "type": "SLACK",
      "url": "${env:PAYMENTS_SLACK_WEBHOOK_URL}",
      "groupIds": [
        "grp_payments"
      ],
      "minSeverity": "WARN",
      "enabled": true
    },
    {
      "id": "chn_ticketing",
      "name": "Ticketing webhook",
      "type": "WEBHOOK",
      "url": "${env:TICKETING_WEBHOOK_URL}",
      "signingSecret": "${env:TICKETING_WEBHOOK_SECRET}",
      "groupIds": [],
      "minSeverity": "DOWN",
      "enabled": true
    },
    {
      "id": "chn_noc_telegram",
      "name": "NOC Telegram group",
      "type": "TELEGRAM",
      "token": "${env:ORBIT_TELEGRAM_BOT_TOKEN}",
      "recipients": [
        "-1001234567890"
      ],
      "groupIds": [],
      "minSeverity": "WARN",
      "enabled": true,
      "locale": "pt-BR"
    },
    {
      "id": "chn_manager_whatsapp",
      "name": "Manager WhatsApp",
      "type": "WHATSAPP",
      "url": "${env:ORBIT_WHATSAPP_MESSAGES_URL}",
      "token": "${env:ORBIT_WHATSAPP_TOKEN}",
      "recipients": [
        "+5511900000000"
      ],
      "groupIds": [
        "grp_payments"
      ],
      "minSeverity": "DOWN",
      "enabled": false,
      "locale": "pt-BR"
    }
  ]
}
