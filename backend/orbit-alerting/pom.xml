<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.orbit</groupId>
        <artifactId>orbit-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>orbit-alerting</artifactId>
    <name>Orbit Monitor - Alerting domain</name>
    <description>Incidents: open on DOWN (or WARN), auto-close on recovery, acknowledgement and comments.</description>

    <dependencies>
        <dependency>
            <groupId>io.orbit</groupId>
            <artifactId>orbit-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.orbit</groupId>
            <artifactId>orbit-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.orbit</groupId>
            <artifactId>orbit-security</artifactId>
        </dependency>
        <!-- BE-28: SMTP e-mail (Jakarta Mail implementation, version managed by Spring Boot). -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <!-- In-process SMTP server for the e-mail channel tests. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
