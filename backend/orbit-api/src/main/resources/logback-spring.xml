<?xml version="1.0" encoding="UTF-8"?>
<!-- Every log line goes through MaskingConverter (%maskedMsg) and every stack trace through
     MaskedThrowableConverter (%maskedEx): no card number, CPF or token is ever logged. -->
<configuration>
    <conversionRule conversionWord="maskedMsg" converterClass="io.orbit.api.privacy.MaskingConverter"/>
    <conversionRule conversionWord="maskedEx" converterClass="io.orbit.api.privacy.MaskedThrowableConverter"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%15.15t] %-40.40logger{39} : %maskedMsg%n%maskedEx"/>
    <property name="FILE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN}"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <!-- BE-53: masked JSON file log, daily + 50 MB rolling, gzip, 30 days, 512 MB cap. -->
    <springProperty name="ORBIT_DATA_DIR" source="orbit.data-dir" defaultValue="${user.home}/.orbit/data"/>
    <include resource="io/orbit/history/applog/file-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ORBIT_FILE"/>
    </root>
</configuration>
