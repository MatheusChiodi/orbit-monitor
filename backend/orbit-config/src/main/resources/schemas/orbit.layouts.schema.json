{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.layouts.schema.json",
  "title": "orbit.layouts.json",
  "description": "Wall layouts and their blocks",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "blocks": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Stable block id within the layout"
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "x": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "y": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "w": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "h": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "field": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "display": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "range": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "24h",
                    "7d",
                    "30d",
                    null
                  ],
                  "description": "FE-58 history window of a series block"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 280,
                  "description": "Plain text of a text block"
                }
              }
            }
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "themeId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$",
            "description": "FE-05 theme of this wall layout"
          },
          "animationLevel": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "off",
              "minimal",
              "standard",
              "expressive",
              null
            ],
            "description": "FE-06 animation override of this wall layout"
          },
          "playlist": {
            "type": [
              "object",
              "null"
            ],
            "description": "FE-19 layouts rotated by the wall that opens this one",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "layout",
                    "seconds"
                  ],
                  "properties": {
                    "layout": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "decimals": {
          "type": [
            "integer",
            "null"
          ]
        },
        "series": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
