{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.notification-templates.schema.json",
  "title": "orbit.notification-templates.json",
  "description": "Notification template overrides per language (en, pt-BR) with {{variable}} placeholders",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string"
              },
              "pt-BR": {
                "type": "string"
              }
            }
          },
          "text": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string"
              },
              "pt-BR": {
                "type": "string"
              }
            }
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
