{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.requests.schema.json",
  "title": "orbit.requests.json",
  "description": "HTTP monitors; credential headers are sealed in the vault",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "intervalSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "timeoutMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "downAfter": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hysteresis": {
            "type": [
              "number",
              "null"
            ]
          },
          "openOnWarn": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "paused": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "conditions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/condition"
            }
          },
          "fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "secretHeaders": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/secret"
            }
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "followRedirects": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "window": {
            "$ref": "#/$defs/window"
          },
          "retry": {
            "$ref": "#/$defs/retry"
          },
          "steps": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$"
                },
                "method": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "headers": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "extract": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "oauth": {
            "type": [
              "object",
              "null"
            ],
            "description": "BE-08 OAuth2 client credentials",
            "required": [
              "tokenUrl",
              "clientId",
              "clientSecret"
            ],
            "properties": {
              "tokenUrl": {
                "type": "string"
              },
              "clientId": {
                "type": "string"
              },
              "clientSecret": {
                "$ref": "#/$defs/secret"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "secret": {
      "description": "Encrypted ({\"enc\": \"v1:...\"}) or an environment reference (\"${env:NAME}\"); never plain text",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "enc"
          ],
          "additionalProperties": false,
          "properties": {
            "enc": {
              "type": "string",
              "pattern": "^v[0-9]+:"
            }
          }
        },
        {
          "type": "string",
          "pattern": "^\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$"
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "WARN",
            "DOWN",
            null
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "decimals": {
          "type": [
            "integer",
            "null"
          ]
        },
        "series": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "window": {
      "type": [
        "object",
        "null"
      ],
      "description": "BE-17 execution window; outside it scheduled checks are skipped",
      "properties": {
        "days": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
            ]
          }
        },
        "from": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "zone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "retry": {
      "type": [
        "object",
        "null"
      ],
      "description": "BE-18 attempts with exponential backoff",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "initialDelayMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 60000
        },
        "multiplier": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "maxDelayMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "attempts"
      ]
    }
  }
}
