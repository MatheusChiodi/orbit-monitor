{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.settings.schema.json",
  "title": "orbit.settings.json",
  "description": "Workspace settings: access policy and workspace defaults (theme, animation level, density, locale, scale) plus history",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "editFrom": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cidrs": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "lanAcknowledge": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "theme": {
            "type": [
              "string",
              "null"
            ]
          },
          "animationLevel": {
            "type": [
              "string",
              "null"
            ],
            "description": "off, minimal, standard or expressive (FE-06)"
          },
          "density": {
            "type": [
              "string",
              "null"
            ],
            "description": "compact, comfortable or spacious"
          },
          "scale": {
            "type": [
              "string",
              "null"
            ],
            "description": "Wall viewing distance preset: 2m, 3m or 5m (FE-08)"
          },
          "historyHours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "branding": {
            "type": [
              "object",
              "null"
            ],
            "description": "FE-10 workspace name and logo (sanitized inline SVG)",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "logoSvg": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 65536
              }
            }
          }
        }
      }
    }
  }
}
