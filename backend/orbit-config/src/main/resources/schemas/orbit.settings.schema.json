{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.settings.schema.json",
  "title": "orbit.settings.json",
  "description": "Workspace settings: access policy, locale, theme, animation level, history",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "editFrom": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cidrs": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "lanAcknowledge": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "theme": {
            "type": [
              "string",
              "null"
            ]
          },
          "animationLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "density": {
            "type": [
              "string",
              "null"
            ]
          },
          "scale": {
            "type": [
              "number",
              "null"
            ]
          },
          "historyHours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
