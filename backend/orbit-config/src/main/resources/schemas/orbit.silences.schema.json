{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.silences.schema.json",
  "title": "orbit.silences.json",
  "description": "Silences and snoozes with reason and expiry",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "until": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
