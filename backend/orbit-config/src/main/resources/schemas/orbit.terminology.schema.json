{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatheusChiodi/orbit-monitor/schemas/orbit.terminology.schema.json",
  "title": "orbit.terminology.json",
  "description": "Custom labels per locale (BE-51, FE-54): i18n key to the workspace's own text",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "enum": [
              "en",
              "pt-BR"
            ]
          },
          "terms": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 instant"
          },
          "updatedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
