<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>io.orbit</groupId>
    <artifactId>orbit-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Orbit Monitor - backend</name>

    <modules>
        <module>orbit-common</module>
        <module>orbit-config</module>
        <module>orbit-security</module>
        <module>orbit-monitor</module>
        <module>orbit-probe</module>
        <module>orbit-telemetry</module>
        <module>orbit-alerting</module>
        <module>orbit-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jsqlparser.version>5.1</jsqlparser.version>
        <springdoc.version>2.8.6</springdoc.version>
        <!-- Tests tagged "pending" cover features not implemented yet (docs/05 section 3). -->
        <surefire.excludedGroups>pending</surefire.excludedGroups>
        <surefire.groups></surefire.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-probe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-telemetry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-alerting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-workspace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.orbit</groupId>
                <artifactId>orbit-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                        <groups>${surefire.groups}</groups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>pending</id>
            <properties>
                <surefire.excludedGroups></surefire.excludedGroups>
                <surefire.groups>pending</surefire.groups>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
